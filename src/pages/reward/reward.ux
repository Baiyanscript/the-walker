<template>
  <div>
    <!-- 获得卡牌 -->
    <block if='{{ rewardType=="获得卡牌" }}'>
      <div class="pageBackGround">
        <text class="text">请选择卡组</text>
        <list class="scroll-ground" style="flex-direction: row">
          <list-item
            type="idonotcare"
            for="{{ rewardCard }}"
            @click="needLongPress"
            class="card-background"
            @longpress="chooseCard($item)"
          >
            <text class="text">{{ pageCardDetail($item) }}</text>
          </list-item>
        </list>
      </div>
    </block>

    <!-- 篝火 -->
    <block elif='{{ rewardType=="篝火" }}'>
      <div
        class="pageBackGround"
        style="justify-content: center; align-items: center; padding: 20px"
      >
        <text style="font-size: 40px; margin-bottom: 20px">[篝火]</text>
        <text class="text" style="text-align: center; margin-bottom: 10px" if="{{ enteredFullHP }}">
          满血进入: 恢复全部生命, 提升最大生命值, 并随机强化一项能力
        </text>
        <text class="text" style="text-align: center; margin-bottom: 10px" elif="{{ !enteredFullHP }}">
          非满血进入: 仅恢复上限60%生命(最多恢复到满血), 随机强化一项能力(幅度降低)
        </text>
        <input
          class="btn"
          type="button"
          value="点火休息"
          onclick="fire"
          style="width: 200px; height: 60px; font-size: 30px"
        />
      </div>
    </block>

    <!-- 强化卡牌(杀戮尖塔化: 每张卡仅可强化一次, 无成功率/失败惩罚) -->
    <block elif='{{ rewardType=="强化卡牌" }}'>
      <div class="pageBackGround">
        <text class="text">强化卡牌:长按选择 (每张仅可强化一次)</text>
        <text class="text">已带"+"的卡牌为已强化</text>
        <list class="scroll-ground" style="flex-direction: row">
          <list-item
            type="idonotcare"
            for="{{ drawPool }}"
            @click="needLongPress"
            class="card-background"
            @longpress="upgradeOnce($item)"
          >
            <text class="text">{{ pageCardDetail($item) }}</text>
          </list-item>
        </list>
        <input type="button" @click="savedAndBack" class="btn" value="离开" />
      </div>
    </block>

    <!-- 遗物(杀戮尖塔化: 三选一, 永久生效; 不重复抽取已拥有的遗物; 无单独遗物栏, 遗物以效果渲染——需求.md) -->
    <block elif='{{ rewardType=="遗物" }}'>
      <div class="pageBackGround">
        <text class="text">遗物:长按选择 (获取后永久生效)</text>
        <text class="text" if="{{ relicCandidates.length === 0 }}">已集齐全部遗物</text>
        <list class="scroll-ground" style="flex-direction: row" if="{{ relicCandidates.length > 0 }}">
          <list-item
            type="relic"
            for="{{ relicCandidates }}"
            @click="needLongPress"
            class="card-background"
            @longpress="chooseRelic($item)"
          >
            <text class="text">{{ relicTxt($item) }}</text>
          </list-item>
        </list>
        <input type="button" @click="savedAndBack" class="btn" value="离开" />
      </div>
    </block>

    <!-- 回收卡牌 -->
    <block elif='{{ rewardType=="回收卡牌" }}'>
      <div class="pageBackGround">
        <text class="text">回收卡牌:长按选择 (可回收{{ maxRecycleCount }}张)</text>
        <text class="text">当前金币:{{ playerInfo.goldNum }}</text>
        <list class="scroll-ground" style="flex-direction: row">
          <list-item
            type="recycle"
            for="{{ drawPool }}"
            @click="needLongPress"
            class="card-background"
            @longpress="recycleCard($item)"
          >
            <text class="text">{{ pageCardDetail($item) }}</text>
            <text class="text">{{ getRecycleGain($item) }}</text>
          </list-item>
        </list>
        <input type="button" @click="savedAndBack" class="btn" value="离开" />
      </div>
    </block>

    <!-- 融合卡牌 -->
    <block elif='{{ rewardType=="融合卡牌" }}'>
      <div class="pageBackGround">
        <text class="text" if="{{ fusionState === 'ask' }}">是否融合以下两张卡?</text>
        <text class="text" elif="{{ fusionState === 'result' }}">融合成功!</text>
        <!-- 询问阶段: 展示 A、B(含 power, 仅融合区展示), 点击进超级详情页 -->
        <list class="scroll-ground" style="flex-direction: row" if="{{ fusionState === 'ask' }}">
          <list-item
            type="fusion"
            for="{{ fusionCards }}"
            class="card-background"
            @click="fusionDetail($item)"
          >
            <text class="text">{{ fusionTxt($item.card) }}</text>
          </list-item>
        </list>
        <!-- 结果阶段: 展示融合卡, 点击进超级详情页 -->
        <list class="scroll-ground" style="flex-direction: row" elif="{{ fusionState === 'result' }}">
          <list-item type="fusionresult" class="card-background" @click="fusionResultDetail">
            <text class="text">{{ fusionTxt(fusionResult) }}</text>
          </list-item>
        </list>
        <!-- 询问阶段按钮 -->
        <div if="{{ fusionState === 'ask' }}" class="button-place">
          <input type="button" class="btn" style="width: 50%" value="融合" onclick="doFusion" />
          <input
            type="button"
            class="btn"
            style="width: 50%; background-color: red"
            value="跳过"
            onclick="savedAndBack"
          />
        </div>
        <!-- 结果阶段按钮 -->
        <input
          elif="{{ fusionState === 'result' }}"
          type="button"
          class="btn"
          style="width: 100%"
          value="下一关"
          onclick="savedAndBack"
        />
      </div>
    </block>

    <!-- 商店(2026-08-14 自 shop.ux 合并入 reward 单页: 少一个页面 = RPK 更小) -->
    <block elif='{{ rewardType=="商店" }}'>
      <div class="pageBackGround">
        <text class="text">商店 (金币:{{ playerInfo.goldNum }})</text>
        <list class="scroll-ground" style="flex-direction: row">
          <list-item
            type="shop"
            for="{{ shopGoods }}"
            class="card-background"
            @click="cardDetail($item)"
            @longpress="buy($item)"
          >
            <text class="text">{{ goodsTxt($item) }}</text>
            <text class="text" if="{{ $item.sold }}">已售</text>
            <text class="text" else>价格:{{ $item.price }}金币</text>
          </list-item>
        </list>
        <input type="button" class="btn" value="离开" onclick="savedAndBack" />
      </div>
    </block>

    <block></block>
  </div>
</template>

<script>
import {getCardDetail, saveForAuto, delay, upgradeCard, gainRelic} from "../../common/lib.js"
import router from "@system.router"
import prompt from "@system.prompt"
// 各区域逻辑模块(与页面同文件夹; 模板界面共用, 逻辑各自独立可测)
import { rollCampfire } from "./fire.js"
import { drawMaterials, computeFusion, consumeMaterials } from "./fusion.js"
import { buildRewardCards } from "./cardGain.js"
import { calcRecycleNum, calcRecycleGain } from "./recycle.js"
import { buildRelicCandidates } from "./relic.js"
import { generateShopGoods } from "./shop.js"

export default {
  private: {
    rewardLevel: 1,
    rewardType: "获得卡牌",
    isBoss: false, // BOSS 战奖励标记(第50层, 来自节点 exDate.isBoss)
    playerInfo: {},
    drawPool: [],
    rewardCard: [],
    maxRecycleCount: 0, // 回收区: 本区域可回收张数
    recycledCount: 0, // 回收区: 已回收张数
    fusionState: "ask", // 融合区: ask=询问是否融合 / result=展示融合结果
    fusionCards: [], // 融合区: [{card, poolIndex}], poolIndex=-1 表示"牌库已空"临时卡(不可销毁)
    fusionResult: {}, // 融合区: 融合出的新卡
    relicCandidates: [], // 遗物区: 三选一候选列表 [{key, name, desc}]
    shopGoods: [], // 商店区: 商品列表 [{type, name, desc, price, sold, apply}]
    lastActionTime: 0, // 商店区: 拦截长按松开后可能误触发的短按(click)

    enteredFullHP: false, // 篝火: 进入时是否满血/溢血(HP >= maxHP, 溢血如不死图腾复活 1.25 倍)

    lastBackTime: 0,
    isLocked: false
  },
  protected: {
    nodeCtxString: ""
  },

  onBackPress() {
    const now = Date.now()
    const diff = now - this.lastBackTime

    if (diff < 2000 && this.lastBackTime !== 0) {
      router.back() // 返回上一页
      return false // 允许系统执行默认返回
    } else {
      this.lastBackTime = now
      prompt.showToast({
        message: "再滑动一次退出",
        duration: 1000
      })
      return true // 阻止默认返回
    }
  },

  async onInit() {
    console.log(`[Reward onInit执行]`)
    let nodeCtx = {}
    try {
      nodeCtx = JSON.parse(this.nodeCtxString)
      console.log("解析nodeCtx成功:", nodeCtx)
      this.rewardLevel = nodeCtx.rewardLevel || 1
      this.rewardType = nodeCtx.rewardType || "获得卡牌"
      this.isBoss = !!(nodeCtx.exDate && nodeCtx.exDate.isBoss) // BOSS 战奖励标记(第50层)
      // 限定卡列表: 由 GLOBAL_LEVEL_SCRIPT 的 exDate.limitedCards 数据驱动(如老渔夫层的"钓鱼佬的鱼竿"),
      // 页面不硬编码任何卡名——存在则 BOSS 奖励走"限定卡+rare3强化"混合三选一(需求.md 2026-08-13)
      this.limitedCards = (nodeCtx.exDate && Array.isArray(nodeCtx.exDate.limitedCards)) ? nodeCtx.exDate.limitedCards : []
    } catch (error) {
      prompt.showToast({message: "数据解析错误: " + error.message, duration: 2000})
      console.error("[onInit] 解析失败", error)
      this.rewardLevel = 1
      this.rewardType = "获得卡牌"
    }

    this.playerInfo = this.$app.$def.playerInfo
    this.drawPool = this.$app.$def.drawPool
    this.pageCardDetail = getCardDetail

    // 篝火: 记录进入时是否满血/溢血(决定是否提升最大生命值)
    this.enteredFullHP = (this.playerInfo.HP || 0) >= (this.playerInfo.maxHP || 0)

    // 回收区: 可回收张数 = 向上取整(关卡等级/2)
    this.maxRecycleCount = calcRecycleNum(this.rewardLevel)
    this.recycledCount = 0

    // ---- 区域初始化: 逻辑在各区域模块(fire/fusion/cardGain/shop/relic/...) ----
    // 遗物区: 三选一候选(排除已拥有, 需求.md bug#3——遗物不会被重复抽取)
    if (this.rewardType === "遗物") {
      this.relicCandidates = buildRelicCandidates(this.playerInfo, 3)
    }

    // 融合区: 随机抽取 A、B(不足 2 张用"牌库已空"临时卡补齐, poolIndex=-1 标记不可销毁)
    if (this.rewardType === "融合卡牌") {
      this.fusionState = "ask"
      this.fusionCards = drawMaterials(this.drawPool)
    }

    // 获得卡牌区: 生成三选一奖励(稀有度权重/30%强化版/BOSS限定卡, 见 cardGain.js)
    if (this.rewardType === "获得卡牌") {
      this.rewardCard = buildRewardCards({
        isBoss: this.isBoss,
        limitedCards: this.limitedCards,
        rewardLevel: this.rewardLevel
      })
    }

    // 商店区: 生成商品(卡牌 + 奖励类型 + 遗物, 见 shop.js)
    if (this.rewardType === "商店") {
      this.shopGoods = generateShopGoods({
        playerInfo: this.playerInfo,
        rewardLevel: this.rewardLevel
      })
    }
  },

  async savedAndBack() {
    this.playerInfo.stage++
    await saveForAuto(this.playerInfo, this.drawPool)
    console.log("保存成功!")
    router.replace({uri: "pages/map"})
  },

  needLongPress() {
    prompt.showToast({message: "请长按触发", duration: 1000})
  },

  chooseCard(card) {
    this.drawPool.push(card)
    this.savedAndBack()
  },

  // ---------- 篝火逻辑(结算在 fire.js) ----------
  async fire() {
    if (this.isLocked) return

    const {log} = rollCampfire({
      playerInfo: this.playerInfo,
      drawPool: this.drawPool,
      rewardLevel: this.rewardLevel,
      enteredFullHP: this.enteredFullHP
    })

    prompt.showToast({message: log, duration: 2500})
    this.isLocked = true

    await delay(2500)
    this.savedAndBack()
  },

  // ---------- 强化卡牌逻辑(杀戮尖塔化: 每张卡仅可强化一次, 无成功率/失败惩罚) ----------
  async upgradeOnce(card) {
    if (this.isLocked) return
    if (!card) return
    if (card.rare === "status") {
      prompt.showToast({message: "状态卡无法强化", duration: 1000})
      return
    }
    if (card.upgraded === true) {
      prompt.showToast({message: "该卡牌已强化", duration: 1000})
      return
    }
    this.isLocked = true
    upgradeCard(card)
    prompt.showToast({message: `${card.name} 强化完成!`, duration: 1500})
    await delay(1500)
    this.savedAndBack()
  },

  // ---------- 遗物逻辑(杀戮尖塔化: 三选一, 永久生效; 候选生成在 relic.js) ----------
  /** 遗物候选展示文本 */
  relicTxt(relic) {
    if (!relic) return "?"
    return `${relic.name}\n${relic.desc}`
  },

  /** 长按选择遗物: 挂永久效果并进入下一关 */
  async chooseRelic(relic) {
    if (this.isLocked) return
    if (!relic || !relic.key) return
    this.isLocked = true
    if (!gainRelic(this.playerInfo, relic.key)) {
      this.isLocked = false
      prompt.showToast({message: "该遗物已拥有", duration: 1000})
      return
    }
    prompt.showToast({message: `获得遗物: ${relic.name}`, duration: 1500})
    await delay(1500)
    this.savedAndBack()
  },

  // ---------- 融合卡牌逻辑(计算/销毁在 fusion.js) ----------
  /** 超级详情页: 查看融合材料(A/B 卡) */
  fusionDetail(item) {
    if (!item || !item.card) return
    router.push({uri: "pages/detail", params: {detailString: JSON.stringify(item.card), type: "card"}})
  },

  /** 超级详情页: 查看融合成品 */
  fusionResultDetail() {
    if (!this.fusionResult || !this.fusionResult.name) return
    router.push({uri: "pages/detail", params: {detailString: JSON.stringify(this.fusionResult), type: "card"}})
  },

  /** 融合区专用展示文本: 普通详情 + power(仅融合区展示 power 参数) */
  fusionTxt(card) {
    return getCardDetail(card) + `|power:${card.power}|`
  },

  /**
   * 确认融合: 逐参数独立抽取 + 技能去重合并(见 fusion.js computeFusion),
   * 销毁 A、B(见 fusion.js consumeMaterials), 融合卡 rare=0 经济惩罚
   */
  doFusion() {
    if (this.fusionState !== "ask") return

    const A = this.fusionCards[0].card
    const B = this.fusionCards[1].card
    this.fusionResult = computeFusion(A, B, this.rewardLevel)
    consumeMaterials(this.drawPool, this.fusionCards)

    // 融合卡加入牌库
    this.drawPool.push(this.fusionResult)

    this.fusionState = "result"
    prompt.showToast({message: `融合成功!`, duration: 1000})
  },

  // ---------- 回收卡牌逻辑(定价/上限在 recycle.js 与 core/core_economy.js) ----------
  /** 单张卡的回金币展示文本 */
  getRecycleGain(card) {
    return `回收: ${calcRecycleGain(this.rewardLevel || 1, card)} 金币`
  },

  /** 长按回收一张卡: 即时入账金币并从牌库移除, 达到上限后由玩家点"离开"结束 */
  async recycleCard(card) {
    if (this.recycledCount >= this.maxRecycleCount) {
      prompt.showToast({message: "已达回收上限", duration: 1000})
      return
    }
    const gain = calcRecycleGain(this.rewardLevel || 1, card)
    this.playerInfo.goldNum = (this.playerInfo.goldNum || 0) + gain
    this.recycledCount += 1

    const index = this.drawPool.indexOf(card)
    if (index !== -1) {
      this.drawPool.splice(index, 1)
    }
    prompt.showToast({message: `回收成功! 金币+${gain}`, duration: 1000})
  },

  // ---------- 商店逻辑(商品生成在 shop.js; 交互留在页面) ----------
  /** 商品展示文本(卡牌描述已含名字, 不再手动拼接) */
  goodsTxt(goods) {
    if (goods.type === "card") return goods.desc
    return `${goods.name}\n${goods.desc}`
  },

  /** 短按: 查看卡牌详情(仅卡牌商品); 拦截长按松开后的误触短按 */
  cardDetail(goods) {
    if (Date.now() - this.lastActionTime < 500) return // 刚长按过(购买), 忽略误触
    if (!goods || goods.type !== "card" || !goods.card) return
    router.push({uri: "pages/detail", params: {detailString: JSON.stringify(goods.card), type: "card"}})
  },

  /** 长按购买: 金币足够则成交并下架, 可继续购买其他商品 */
  buy(goods) {
    if (goods.sold) return
    this.lastActionTime = Date.now() // 拦截: 长按松开后可能额外触发一次短按(click)
    if (this.playerInfo.goldNum < goods.price) {
      prompt.showToast({message: "金币不足!", duration: 1000})
      return
    }
    this.playerInfo.goldNum -= goods.price
    if (typeof goods.apply === "function") {
      goods.apply(this.playerInfo, this.drawPool)
    }
    goods.sold = true
    prompt.showToast({message: `购买成功: ${goods.name}`, duration: 1000})
  }
}
</script>

<style>
.scroll-ground {
  height: 150px;
  width: 100%;
  align-items: center;
  background-color: #1f1f11;
}
.card-background {
  background-color: #b8c5006c;
  border: 2px solid #ffee00;
  height: 150px;
  width: 150px;
  flex-direction: column;
  justify-content: flex-start;
  display: flex;
}
</style>
