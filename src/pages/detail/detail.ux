<template>
  <div class="pageBackGround">
    <scroll class="detail-scroll" scroll-x="true" scroll-y="true">
      <text class="title">{{ titleTxt }}</text>
      <text class="text" style="text-align: left">结构:\n{{ rawJson }}</text>
      <text class="section">{{ sectionTxt }}</text>
      <text class="text" style="text-align: left" for="{{ skillTxts }}">{{ $item }}</text>
      <text class="section">{{ effSectionTxt }}</text>
      <text class="text" style="text-align: left" for="{{ effTxts }}">{{ $item }}</text>
    </scroll>
    <div class="button-place">
      <input type="button" class="btn" value="返回" onclick="back" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import {getSkillDetail, getEffectDetail} from "../../common/lib.js"

export default {
  private: {
    titleTxt: "",
    rawJson: "",
    skillTxts: [],
    sectionTxt: "技能/行动", // 玩家类型时改为 "属性/遗物"
    effSectionTxt: "效果",
    effTxts: []
  },
  protected: {
    detailString: "",
    type: "card"
  },

  onInit() {
    const isMob = this.type === "mob"
    const isPlayer = this.type === "player"

    // 玩家自身数据: 不解析 detailString, 直接读全局 playerInfo
    if (isPlayer) {
      const p = this.$app.$def.playerInfo || {}
      this.titleTxt = "玩家数据"
      this.sectionTxt = "属性/遗物"
      this.rawJson = Object.keys(p).length ? JSON.stringify(p, null, 2) : "(无存档数据)"
      const relics = (p.relics || []).map((r) => `■ ${r.name}`)
      this.skillTxts = [
        `HP:${p.HP}/${p.maxHP} AP:${p.AP}/${p.maxAP} DP:${p.DP || 0}`,
        `金币:${p.goldNum} 关卡:${p.stage} 预设:${p.presetKey || "?"}`,
        `遗物:${relics.length > 0 ? "\n" + relics.join("\n") : "(无)"}`
      ]
      const effs = p.effect || []
      this.effSectionTxt = "玩家所携带效果"
      this.effTxts = effs.length > 0
        ? effs.map((e) => {
            const detail = getEffectDetail(e, p, true)
            return `■ ${e.key}\ndetail: ${detail || "(无描述)"}`
          })
        : ["(无效果)"]
      return
    }

    let obj = null
    try {
      obj = JSON.parse(this.detailString)
    } catch (e) {
      console.warn("[detail] 解析 detailString 失败", e)
    }
    this.titleTxt = (obj && obj.name || "?")
    this.rawJson = obj ? JSON.stringify(obj, null, 2) : "(解析失败)"

    // 技能/行动: 卡牌 doSkill, 怪物 act —— 展示 detail 描述(SD=true: 超级详情文案)
    const skillKeys = isMob ? ((obj && obj.act) || []) : ((obj && obj.doSkill) || [])
    this.skillTxts = skillKeys.map((k) => {
      const detail = getSkillDetail(k, obj, true)
      return `■ ${k}\n detail: ${detail || "(无描述)"}`
    })
    if (this.skillTxts.length === 0) this.skillTxts = ["(无技能)"]

    // 效果: 卡牌详情显示玩家自身 effect(方便查看自己状态); 怪物详情显示自身 effect
    let effSource = null
    if (isMob) {
      effSource = obj
      this.effSectionTxt = "怪物所携带效果"
    } else {
      effSource = this.$app.$def.playerInfo
      this.effSectionTxt = "玩家所携带效果"
    }
    const effs = (effSource && effSource.effect) || []
    this.effTxts = effs.length > 0
      ? effs.map((e) => {
          const detail = getEffectDetail(e, effSource, true)
          return `■ ${e.key}\ndetail: ${detail || "(无描述)"}`
        })
      : ["(无效果)"]
  },

  back() {
    router.back()
  }
}
</script>

<style>
.detail-scroll {
  /* 自适应: 占满按钮区之外的剩余空间(父容器为 column flex, 占满屏) */
  flex: 1;
  width: 100%;
}

.title {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
  margin: 10px;
}

.section {
  font-size: 20px;
  font-weight: bold;
  color: #00c853;
  margin: 10px;
}

.text {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.8);
  margin: 4px 10px;
}

.button-place {
  flex-direction: row;
  width: 100%;
  height: 60px;
}
</style>
