<template>
  <div class="pageBackGround">
    <block if="{{ showCardPool }}">
      <text class="text">卡组({{ drawPool.length }}张)</text>
      <!-- 照搬强化卡牌 UI: list 直接用 scroll-ground(有高度), 不要用 card-list(该样式只在 fighting.ux 定义) -->
      <list class="scroll-ground" style="flex-direction: row">
        <list-item
          type="cardpool"
          for="{{ drawPool }}"
          class="card-background"
          @longpress="cardDetail($item)"
        >
          <text class="text">{{ pageCardDetail($item) }}</text>
        </list-item>
      </list>
      <div class="button-place">
        <input type="button" class="btn" style="width: 50%" value="关闭" onclick="toggleCardPool" />
      </div>
    </block>

    <!-- 地图视图 -->
    <block elif="{{ !showCardPool }}">
      <text class="text">当前层数:{{ playerInfo.stage }}</text>
      <list class="scroll-ground">
        <list-item
          type="justKiding"
          for="{{ chose }}"
          class="card-background"
          @click="needLongPress()"
          @longpress="enter($idx)"
        >
          <text class="text">{{ getPlaceDetail($item) }}</text>
        </list-item>
      </list>
      <scroll class="button-place" scroll-x="true">
        <div style="justify-content: flex-start; width: {{ detailWidth }}px">
          <!--宽度按内容动态计算(updateDetailWidth), 内容不够长时横向扩展而非纵向换行-->
          <text class="text" style="text-align: left" @longpress="playerDetail()">
            {{ getPlayerDetail() }}
          </text>
        </div>
      </scroll>

      <div class="button-place">
        <input
          type="button"
          class="btn"
          style="width: 50%"
          value="查看卡组"
          onclick="toggleCardPool"
        />
        <input
          type="button"
          class="btn"
          style="width: 50%; background-color: #ff3b30"
          @click="needLongPress()"
          @longpress="saveAndExit()"
          value="保存退出"
        />
      </div>
    </block>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import router from "@system.router"
import {
  getEffectDetail,
  getCardDetail,
  saveForAuto,
  getLevelScript,
  getGenerator
} from "../../common/lib.js"

export default {
  private: {
    playerInfo: {},
    chose: [],
    showCardPool: false, // 查看卡组视图开关
    drawPool: []
  },
  async onInit() {
    this.playerInfo = this.$app.$def.playerInfo
    this.drawPool = this.$app.$def.drawPool
    this.pageCardDetail = getCardDetail

    this.rollLevel()
  },

  /** 切换"查看卡组"视图 */
  toggleCardPool() {
    this.showCardPool = !this.showCardPool
  },

  /** 超级详情页(测试版): 长按卡组中的卡查看(含玩家自身效果) */
  cardDetail(card) {
    if (!card) return
    router.push({uri: "pages/detail", params: {detailString: JSON.stringify(card), type: "card"}})
  },

  getPlayerDetail() {
    const p = this.playerInfo
    let txt = `HP:${p.HP}/${p.maxHP} AP:${p.AP}/${p.maxAP} 金币:${p.goldNum}`

    // 追加效果(buff)信息(遗物效果也在其中: 以 `遗物·${name}` 渲染, 无单独遗物栏——需求.md)
    const effects = p.effect || []
    for (let i = 0; i < effects.length; i++) {
      const eff = effects[i]
      const detail = getEffectDetail(eff, p)
      if (detail) {
        txt += "[" + detail + "]"
      }
    }
    return txt
  },

  /**
   * 玩家信息条宽度(px): 基础信息宽度 + 每个效果额外10%界面框(余量防估算偏差)
   * 内容不足时横向扩展而非纵向换行(与 scroll-x 配合滚动查看); computed 自动重算
   */
  computed: {
    detailWidth() {
      // 获取效果数组，安全兜底
      const effects = this.playerInfo?.effect || []
      // 基础宽度 200% + 每个效果额外增加 10% 宽度
      return `${200 + effects.length * 10}%`
    }
  },

  /** 超级详情页(测试版): 长按信息条查看玩家自身数据 */
  playerDetail() {
    router.push({uri: "pages/detail", params: {type: "player"}})
  },

  getPlaceDetail(level) {
    let txt = ""
    const isPure = !level.mobSet || level.mobSet.length === 0

    if (isPure) {
      txt += `奖励:${level.rewardType || "?"}\n`
      txt += `无战斗`
    } else {
      const totalWaves = level.mobSet.length
      const totalMobs = level.mobSet.reduce((sum, w) => sum + w.numOfMob, 0)
      const rare = level.mobSet[0].totalRare || "?"
      txt += `${level.isHard ? "困难" : ""}战斗\n`
      txt += `${totalWaves}波${totalMobs}只\n`
      txt += `稀有度${rare}`
      txt += `奖励:${level.rewardType || "?"}\n`
    }
    return txt
  },

  /**
   * 把固定脚本节点展开为标准平铺节点结构(map 生成器产出同构)
   * rewardLevel: "hard" -> 3(困难档, 2026-08-15 level隐藏方案: 固定不再随层数); 数字直接采用
   */
  expandScriptNode(node, stage) {
    const rewardLevel =
      node.rewardLevel === "hard" ? 3 : node.rewardLevel || 1
    if (node.mobSet && node.mobSet.length) {
      // 战斗节点
      return {
        mobLevel: node.mobLevel || 1,
        mobSet: node.mobSet,
        rewardLevel,
        isHard: !!node.isHard,
        rewardType: node.rewardType,
        exDate: node.exDate
      }
    }
    // 纯奖励节点
    return {
      mobLevel: 0,
      mobSet: [],
      rewardLevel,
      _isHard: false,
      rewardType: node.rewardType,
      exDate: node.exDate
    }
  },

  rollLevel() {
    const stage = this.playerInfo.stage || 1

    // 固定层数脚本: 命中(全局/角色)则整层替换随机; 未命中/校验失败 getLevelScript 返回 null -> 走随机
    // ⭐ 固定脚本层不经过地图生成器(需求.md: 不影响49层的纯奖励)
    const script = getLevelScript(stage, this.playerInfo.presetKey)
    if (script) {
      this.chose = script.nodes.map((node) => this.expandScriptNode(node, stage))
      return
    }

    // 随机层: 通过地图生成器(map_common 或玩家 map.typeOfMap 声明的扩展生成器, 提取失败回退默认)
    const gen = getGenerator(this.playerInfo, "map")
    this.chose = gen({playerInfo: this.playerInfo})
  },

  enter(idx) {
    const enter = this.chose[idx]
    const dataStr = JSON.stringify(enter)

    if (!enter.mobSet || !enter.mobSet.length) {
      // 纯奖励节点: 全部走 reward 页(商店已合并为 reward 的"商店"区域)
      router.replace({uri: "pages/reward", params: {nodeCtxString: dataStr}})
    } else {
      // 有战斗: 先打, 胜利后 fighting.Win() 统一进 reward 页(按 rewardType 渲染对应区域)
      router.replace({uri: "pages/fighting", params: {battleCtxString: dataStr}})
    }
  },

  needLongPress() {
    prompt.showToast({message: "请长按触发", duration: 1000})
  },

  async saveAndExit() {
    saveForAuto(this.playerInfo)
    router.replace({uri: "pages/index"})
  }
}
</script>

<style>
.scroll-ground {
  height: 150px;
  width: 100%;
  align-items: center;
  background-color: #0d0d0d;
  flex-direction: row;
  /* 后续添加背景色便于调试 */
}

.card-background {
  background-color: #262626;
  border: 1px solid #3a3a3a;
  border-radius: 16px;
  height: 150px;
  width: 150px;
  flex-direction: column;
  justify-content: flex-start;
  display: flex;
}

.button-place {
  flex-direction: row;
  width: 100%;
  height: 60px;
}
</style>
